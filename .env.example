# Primary provider (OpenAI is the default primary and a native provider)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_NAME=gpt-5.4-mini
# PRIMARY_MODEL is used only when OPENAI_MODEL_NAME is unset; use it to pick a
# non-OpenAI primary, e.g. PRIMARY_MODEL=anthropic/claude-<model-id>
# PRIMARY_MODEL=gpt-5.4-mini

# Provider & model fallback: comma-separated provider/model list tried in order
# when the primary fails with a transient/provider error. Each model uses its
# provider's standard key env var. OpenAI + Anthropic are bundled as native
# providers; Groq/OpenRouter/DeepSeek/etc. route via the bundled LiteLLM backend.
# FALLBACK_MODELS=anthropic/claude-<model-id>,groq/llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# ---- Local / self-hosted inference (vLLM, Ollama) ----
# Address a local server with a provider prefix; no API key is required.
# The model name after the prefix is the server's served model name
# (vLLM: --served-model-name).
# PRIMARY_MODEL=hosted_vllm/my-served-model
# PRIMARY_MODEL=ollama/llama3.1
#
# LLM_API_BASE: endpoint of the server. Only needed when it is not at the
# provider default (vLLM http://localhost:8000/v1, Ollama
# http://localhost:11434/v1) -- e.g. a remote host, or reaching the host from
# inside a container.
# LLM_API_BASE=http://localhost:8000/v1
#
# LLM_CONTEXT_WINDOW: context window of the model, in tokens. Set this for
# local models. CrewAI infers the window from a table of hosted model names; a
# self-hosted name matches nothing and falls back to 8192, which is smaller
# than Skill Sentinel's own prompt overhead and makes the crew summarise or
# fail mid-scan. Use the server's configured maximum (vLLM --max-model-len).
# LLM_CONTEXT_WINDOW=32768

# Optional: enables VirusTotal binary malware scanning
VIRUSTOTAL_API_KEY=your-vt-api-key
